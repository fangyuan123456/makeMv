# FMV & VideoClaw Agent Configuration
PORT=8000
HOST=127.0.0.1
MOCK_MODE=true

# LLM Provider (OpenAI Compatible: DeepSeek / Qwen / Ark / OpenAI)
LLM_PROVIDER=openai
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus

# Image Generation Provider (dashscope / ark / openai / mock)
IMAGE_PROVIDER=mock
IMAGE_API_KEY=
IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
IMAGE_MODEL=wanx-v1

# Video Generation Provider (dashscope / kling / ark / mock)
VIDEO_PROVIDER=mock
VIDEO_API_KEY=
VIDEO_BASE_URL=https://dashscope.aliyuncs.com/api/v1
VIDEO_MODEL=wan2.1-i2v-plus

# Path to FFmpeg executable (auto-detects local _tools/ffmpeg if empty)
FFMPEG_PATH=
