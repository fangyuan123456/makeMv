{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 启动服务端 (Server API)",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "build:server",
      "program": "${workspaceFolder}/server/dist/index.js",
      "cwd": "${workspaceFolder}/server",
      "runtimeArgs": [
        "--enable-source-maps"
      ],
      "outFiles": [
        "${workspaceFolder}/server/dist/**/*.js"
      ],
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/server/dist/**",
        "!**/node_modules/**"
      ],
      "sourceMapPathOverrides": {
        "../../../src/*": "${workspaceFolder}/server/src/*",
        "../../src/*": "${workspaceFolder}/server/src/*",
        "../src/*": "${workspaceFolder}/server/src/*",
        "./src/*": "${workspaceFolder}/server/src/*"
      },
      "smartStep": true,
      "restart": true,
      "skipFiles": [
        "<node_internals>/**"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "🔗 附加到已有服务 (Attach to Process: 9229)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/server/dist/**/*.js"
      ],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/server/dist/**",
        "!**/node_modules/**"
      ],
      "sourceMapPathOverrides": {
        "../../../src/*": "${workspaceFolder}/server/src/*",
        "../../src/*": "${workspaceFolder}/server/src/*",
        "../src/*": "${workspaceFolder}/server/src/*",
        "./src/*": "${workspaceFolder}/server/src/*"
      },
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "🎬 运行 CLI 导演测试 (端到端成片)",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "build:server",
      "program": "${workspaceFolder}/server/dist/cli.js",
      "cwd": "${workspaceFolder}/server",
      "runtimeArgs": [
        "--enable-source-maps"
      ],
      "outFiles": [
        "${workspaceFolder}/server/dist/**/*.js"
      ],
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/server/dist/**",
        "!**/node_modules/**"
      ],
      "sourceMapPathOverrides": {
        "../../../src/*": "${workspaceFolder}/server/src/*",
        "../../src/*": "${workspaceFolder}/server/src/*",
        "../src/*": "${workspaceFolder}/server/src/*",
        "./src/*": "${workspaceFolder}/server/src/*"
      },
      "skipFiles": [
        "<node_internals>/**"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "💻 启动客户端 (Next.js WebUI)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:client"
      ],
      "cwd": "${workspaceFolder}",
      "sourceMaps": false,
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**",
        "**/.next/**"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ],
  "compounds": [
    {
      "name": "🌟 全栈联调 (Server + Client)",
      "configurations": [
        "🚀 启动服务端 (Server API)",
        "💻 启动客户端 (Next.js WebUI)"
      ],
      "stopAll": true
    }
  ]
}
