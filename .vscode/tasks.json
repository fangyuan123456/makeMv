{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "释放 4111 端口",
      "type": "shell",
      "command": "Get-NetTCPConnection -LocalPort 4111 -State Listen -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force }",
      "windows": {
        "command": "powershell -NoProfile -Command \"Get-NetTCPConnection -LocalPort 4111 -State Listen -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force }\""
      },
      "presentation": {
        "reveal": "silent"
      }
    },
    {
      "label": "启动客户端开发服务器 (Vite)",
      "type": "shell",
      "command": "npm run dev:client",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "source": "vite",
        "applyTo": "allDocuments",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(?!x)x$",
          "file": 1,
          "line": 1,
          "column": 1,
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*",
          "endsPattern": ".*(Local:|ready in).*"
        }
      }
    },
    {
      "label": "tsc: build (server)",
      "type": "shell",
      "command": "npm run build --prefix server",
      "problemMatcher": ["$tsc"],
      "group": "build"
    }
  ]
}
