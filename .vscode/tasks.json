{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "启动客户端开发服务器 (Vite)",
      "type": "shell",
      "command": "npm run dev:client",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": [{ "regexp": "^$" }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*",
          "endsPattern": ".*(Local:|ready in).*"
        }
      }
    },
    {
      "label": "tsc: build (server)",
      "type": "shell",
      "command": "npm run build --prefix server",
      "problemMatcher": ["$tsc"],
      "group": "build"
    }
  ]
}
